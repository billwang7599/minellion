{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minellion question bank",
  "type": "object",
  "required": ["start", "prompts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "start": {
      "description": "Date of dive #1. Each day's 7 prompts are dealt from this bank by date.",
      "$ref": "#/$defs/date"
    },
    "prompts": {
      "description": "Append only: never delete or reorder, or past days change. Editing text or answers in place is fine.",
      "type": "array",
      "items": { "$ref": "#/$defs/prompt" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "prompt": {
      "type": "object",
      "required": ["added", "category", "tags", "text", "answers"],
      "additionalProperties": false,
      "properties": {
        "added": {
          "description": "First date this prompt may be dealt. New prompts need a date after today.",
          "$ref": "#/$defs/date"
        },
        "category": { "description": "The label the game shows.", "type": "string", "minLength": 1 },
        "tags": {
          "description": "What the prompt is about. A day avoids dealing two prompts that share a tag.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["mobs", "blocks", "items", "world", "nether", "end", "crafting", "loot", "names", "lore", "mechanics"]
          }
        },
        "text": { "type": "string", "minLength": 1 },
        "answers": {
          "description": "Accepted answers grouped by rarity tier, from most obvious (dirt) to rarest (netherite).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dirt": { "$ref": "#/$defs/answers" },
            "coal": { "$ref": "#/$defs/answers" },
            "iron": { "$ref": "#/$defs/answers" },
            "gold": { "$ref": "#/$defs/answers" },
            "diamond": { "$ref": "#/$defs/answers" },
            "netherite": { "$ref": "#/$defs/answers" }
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "description": "A name, or [name, ...aliases] for names that count in this prompt only. Nicknames that always mean the same thing go in aliases.json.",
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
        ]
      }
    }
  }
}
