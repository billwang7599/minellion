{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minellion daily dives",
  "type": "object",
  "required": ["days"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "days": {
      "description": "One entry per calendar day, consecutive and in date order. Dive number is index + 1.",
      "type": "array",
      "items": { "$ref": "#/$defs/day" }
    }
  },
  "$defs": {
    "day": {
      "type": "object",
      "required": ["date", "prompts"],
      "additionalProperties": false,
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "prompts": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/prompt" } }
      }
    },
    "prompt": {
      "type": "object",
      "required": ["category", "text", "answers"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "answers": {
          "description": "Accepted answers grouped by rarity tier, from most obvious (dirt) to rarest (netherite).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dirt": { "$ref": "#/$defs/answers" },
            "coal": { "$ref": "#/$defs/answers" },
            "iron": { "$ref": "#/$defs/answers" },
            "gold": { "$ref": "#/$defs/answers" },
            "diamond": { "$ref": "#/$defs/answers" },
            "netherite": { "$ref": "#/$defs/answers" }
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "description": "A name, or [name, ...aliases] when other spellings or old names should also count.",
        "oneOf": [
          { "type": "string", "minLength": 1 },
          { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
        ]
      }
    }
  }
}
